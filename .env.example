# --- Envoi des demandes ECTN/BESC (/api/demande) ---
# MODELE uniquement. Ne mettez PAS de vraie valeur ici : ce fichier est versionné.
# Copiez-le en `.env.local` (ignoré par git) et renseignez-y vos secrets.

# Clé API Resend (https://resend.com/api-keys). Sans elle, le formulaire /demande
# répond une erreur "email_not_configured" et rien n'est envoyé.
RESEND_API_KEY=

# Adresse qui reçoit les demandes. Par défaut : info@beninbesc.com
ECTN_INBOX=info@beninbesc.com

# Expéditeur affiché. Doit utiliser un domaine vérifié dans Resend.
# Pour un premier test sans domaine : "Africa BESC <onboarding@resend.dev>"
# (dans ce cas, l'envoi n'est possible que vers l'e-mail du compte Resend).
RESEND_FROM="Africa BESC <no-reply@africa-besc.com>"
